{
  "name": "mail-admin-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:reads": "tsc --ignoreConfig --target ES2022 --module ES2022 --outDir ../build/read-tests src/api.ts src/format.ts && node ../tools/check_reads.mjs",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
