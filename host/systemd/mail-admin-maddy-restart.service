[Unit]
Description=Restart Maddy when the dashboard requests it after a relay change
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/usr/local/lib/mail-admin
ExecStart=/usr/bin/python3 -m host.maddy_restart
MemoryMax=128M
CPUQuota=50%
TasksMax=64
TimeoutStartSec=60
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mail-admin-helper
LogNamespace=mail-admin
