[Unit]
Description=Process administrator backup and mail recovery operations
After=docker.service mail-admin-helper.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
WorkingDirectory=/usr/local/lib/mail-admin
ExecStart=/usr/bin/python3 -m host.backup_control
MemoryMax=512M
CPUQuota=50%
TasksMax=128
TimeoutStartSec=1h
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mail-admin-helper /var/lib/mail-admin-backup /opt/maddy/data /opt/mail-admin/data /var/lib/mail-admin-certificates /run/lock
LogNamespace=mail-admin
