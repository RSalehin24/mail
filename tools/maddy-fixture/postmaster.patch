+// RFC 5321 permits the complete case-insensitive Postmaster forward-path.
+// Reverse-path and ordinary mailbox parsing retain their existing validation.
+func (p *parser) parseForwardPath() (string, error) {
+	end := strings.IndexAny(p.s, " \t")
+	if end < 0 {
+		end = len(p.s)
+	}
+	token := p.s[:end]
+	if strings.EqualFold(token, "postmaster") || strings.EqualFold(token, "<postmaster>") {
+		p.s = p.s[end:]
+		return "postmaster", nil
+	}
+	return p.parsePath()
+}
